# Player progress — this is personal state, not source. It carries real names.
# server.py writes one file per player next to index.html on the machine it
# runs on, so the per-player pattern has to be covered too, not just the
# original single file.
progress.json
progress.json.tmp
progress-*.json
progress-*.json.tmp
loopline-progress-*.json

